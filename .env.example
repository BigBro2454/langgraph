# ─────────────────────────────────────────────
# LangGraph / LangChain – Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# Never commit .env to version control.

# --- LLM Providers ---
# Google Gemini (Primary recommended default matching google-adk setup)
GOOGLE_API_KEY="your_google_api_key_here"

# OpenAI (Optional - for gpt-4o / gpt-4o-mini)
# OPENAI_API_KEY="your_openai_api_key_here"

# Anthropic (Optional - for claude-3-5-sonnet)
# ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Local Ollama Fallback URL (defaults to http://localhost:11434)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_DEFAULT_MODEL="qwen2.5:7b"

# --- Langfuse (daily traces for this folder) ---
# Create a project at http://localhost:3000 after Langfuse is running,
# or use Langfuse Cloud and set LANGFUSE_BASE_URL to your region host.
# Leave both keys empty to run agents with tracing off.
# LANGFUSE_PUBLIC_KEY="pk-lf-..."
# LANGFUSE_SECRET_KEY="sk-lf-..."
# LANGFUSE_BASE_URL="http://localhost:3000"

# --- LangSmith (optional; LCAE Section 3/4 study only) ---
# Turn this on only when you are studying LangSmith. Leave it off while Langfuse is on,
# or one run is split across two backends.
# LANGSMITH_TRACING="true"
# LANGSMITH_API_KEY="your_langsmith_api_key_here"
# LANGSMITH_PROJECT="langgraph-agents"
