# ─────────────────────────────────────────────
# LangGraph / LangChain – Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# Never commit .env to version control.

# --- LLM Providers ---
# Google Gemini (Primary recommended default matching google-adk setup)
GOOGLE_API_KEY="your_google_api_key_here"

# OpenAI (Optional - for gpt-4o / gpt-4o-mini)
# OPENAI_API_KEY="your_openai_api_key_here"

# Anthropic (Optional - for claude-3-5-sonnet)
# ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Local Ollama Fallback URL (defaults to http://localhost:11434)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_DEFAULT_MODEL="qwen2.5:7b"

# --- LangSmith Observability & Tracing (Optional for local dev, needed for Section 3/4) ---
# LANGSMITH_TRACING="true"
# LANGSMITH_API_KEY="your_langsmith_api_key_here"
# LANGSMITH_PROJECT="langgraph-agents"
